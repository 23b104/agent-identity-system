# Copy to .env and fill in for local development.
# In production (Render/Railway/Fly), set these as real environment variables
# in the platform dashboard instead — never commit a filled-in .env.

ENV=development

# Postgres in production; defaults to local SQLite file if unset.
# DATABASE_URL=postgresql://user:pass@host:5432/agent_identity

# MUST be a long random string in production. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-change-me-in-production

# Gate for admin endpoints (register/rotate/suspend/review). Generate the same way.
ADMIN_API_KEY=dev-admin-key

DEFAULT_CREDENTIAL_TTL_DAYS=90
STALE_THRESHOLD_DAYS=30

# Free key: https://console.groq.com/keys — powers the autonomous review agent.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# How often the agent reviews itself with no human trigger. Set to 0 to disable.
AI_REVIEW_INTERVAL_HOURS=6
